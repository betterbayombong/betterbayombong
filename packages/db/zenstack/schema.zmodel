datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [vector, postgis, pgrouting]
}

plugin ts {
    provider = "@core/typescript"
    output   = "../generated"
}

model Hotline {
    id        String   @id @default(uuid(7))
    office    String
    number    String
    icon      String
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("hotlines")
}
